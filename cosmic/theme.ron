// COSMIC (libcosmic) dark theme, read by Cosmic Files and other libcosmic apps.
//
// libcosmic stores its theme as one RON file per top-level field in
// ~/.config/cosmic/com.system76.CosmicTheme.Dark/v2/. matugen can only write a
// single file per template, so each field lives in its own "@@ <field>"
// section and scripts/cosmic-theme-apply.sh splits them apart (post_hook).
//
// Colors are "#RRGGBBAA". The window background is ~79% opaque (alpha c9).
// Layers on top of it (secondary panels, component bases, buttons, input
// backgrounds) are 20% opaque (33; disabled 1a, small widgets 0d). Things
// that need to stand out are stronger: the side panel (primary.base) and the
// Cosmic Files item hover (background.component.base) are 50% (80), hover
// states 50% (80), pressed / selected states 60% (99). Selected items use
// the accent component, styled like the sidebar's selection: a 30% neutral
// (outline) tint with primary-colored text. The sidebar's own selection is
// palette.neutral_5 at a fixed 20% (set by libcosmic), so neutral_5 is the
// lighter outline tone for definition.
//
// Cosmic Files requests compositor blur (ext-background-effect, which
// Hyprland supports), so libcosmic runs in "transparent" mode: menus and
// popups take their background from transparent_background.component.base,
// while the file hover reads the opaque background.component.base. That's
// the one place the two sets differ: the context menu is a dark 88% (e0),
// with Hyprland blurring behind it.
//
// accent_button (suggested actions, e.g. Save in the file picker) keeps its
// translucent primary fill but uses the regular text color (on_surface),
// since on_primary is too close to the tinted fill. Text, icons,
// borders, dividers and focus rings stay fully opaque. Both the opaque and
// transparent_* containers get the
// alpha, since libcosmic only uses transparent_* when compositor blur is
// negotiated.
//
// Fields left out (success, warning, spacing, radii,
// ...) fall back to libcosmic's built-in dark defaults.
//
// Mirrors the DMS "Dynamic Black" look: pure black window background, with
// Material surface tones for the elevated layers.

@@ name
"Matugen"

@@ is_dark
true

@@ frosted_windows
true

@@ frosted_maximized_apps
true

@@ accent_text
Some("#adc6ffff")

@@ background
(
    base: "#000000c9",
    component: (
        base: "#282a2f80",
        hover: "#33353a80",
        pressed: "#33353a99",
        selected: "#33353a99",
        selected_text: "#adc6ffff",
        focus: "#adc6ffff",
        divider: "#44474fff",
        on: "#e2e2e9ff",
        disabled: "#1a1b201a",
        on_disabled: "#e2e2e980",
        border: "#44474fff",
        disabled_border: "#44474f80",
    ),
    divider: "#44474fff",
    on: "#e2e2e9ff",
    small_widget: "#33353a0d",
)

@@ transparent_background
(
    base: "#000000c9",
    component: (
        base: "#0c0e13e0",
        hover: "#33353a80",
        pressed: "#33353a99",
        selected: "#33353a99",
        selected_text: "#adc6ffff",
        focus: "#adc6ffff",
        divider: "#44474fff",
        on: "#e2e2e9ff",
        disabled: "#1a1b201a",
        on_disabled: "#e2e2e980",
        border: "#44474fff",
        disabled_border: "#44474f80",
