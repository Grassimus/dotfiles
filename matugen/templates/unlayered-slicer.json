{
  "version": 1,
  "name": "Matugen",
  "base": "dark",
  "colors": {
    "accent": "{{ colors.primary_container.default.hex }}",
    "button_input_text": "{{ colors.on_surface.default.hex }}",
    "buttons": "{{ colors.surface_container_high.default.hex | lighten: -1.5 | set_saturation: 15.0 }}",
    "disabled_text": "{{ colors.outline.default.hex }}",
    "input_background": "{{ colors.surface_container_highest.default.hex | lighten: -2.0 | set_saturation: 15.0 }}",
    "input_borders": "{{ colors.secondary_container.default.hex }}",
