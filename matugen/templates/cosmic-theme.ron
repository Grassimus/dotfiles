@@ link_button
(
    base: "#00000000",
    hover: "#00000000",
    pressed: "#00000000",
    selected: "#00000000",
    selected_text: "{{ colors.primary.default.hex }}ff",
    focus: "{{ colors.primary.default.hex }}ff",
    divider: "{{ colors.outline_variant.default.hex }}ff",
    on: "{{ colors.primary.default.hex }}ff",
    disabled: "#00000000",
    on_disabled: "{{ colors.primary.default.hex }}80",
    border: "#00000000",
    disabled_border: "#00000000",
)

@@ palette
(
    name: "Matugen",
    bright_red: "{{ colors.error.default.hex }}ff",
    bright_green: "#5EDB8CFF",
    bright_orange: "#FFA37DFF",
    gray_1: "{{ colors.surface_container_low.default.hex }}33",
    gray_2: "{{ colors.surface_container.default.hex }}33",
    neutral_0: "#00000033",
    neutral_1: "{{ colors.surface_container_lowest.default.hex }}33",
    neutral_2: "{{ colors.surface_container_low.default.hex }}33",
    neutral_3: "{{ colors.surface_container.default.hex }}33",
    neutral_4: "{{ colors.surface_container_high.default.hex }}33",
    neutral_5: "{{ colors.outline.default.hex }}33",
    neutral_6: "{{ colors.outline_variant.default.hex }}ff",
    neutral_7: "{{ colors.outline.default.hex }}ff",
    neutral_8: "{{ colors.on_surface_variant.default.hex }}ff",
    neutral_9: "{{ colors.on_surface.default.hex }}ff",
    neutral_10: "#ffffffff",
    accent_blue: "#63D0DFFF",
    accent_indigo: "#A1C0EBFF",
    accent_purple: "#E79CFEFF",
    accent_pink: "#FF9CB1FF",
    accent_red: "#FDA1A0FF",
    accent_orange: "#FFAD00FF",
    accent_yellow: "#F7E062FF",
    accent_green: "#92CF9CFF",
    accent_warm_grey: "#CABAB4FF",
    ext_warm_grey: "#9B8E8AFF",
    ext_orange: "#FFAD00FF",
    ext_yellow: "#FEDB40FF",
    ext_blue: "#48B9C7FF",
    ext_purple: "#CF7DFFFF",
    ext_pink: "#F93A83FF",
    ext_indigo: "#3E88FFFF",
)
